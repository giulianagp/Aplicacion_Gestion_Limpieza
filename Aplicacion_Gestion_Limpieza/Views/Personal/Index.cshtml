@model IEnumerable<Aplicacion_Gestion_Limpieza.Models.Personal>

@{
    ViewData["Title"] = "Personal";
}

<h1>Personal</h1>

<div class="mb-3">
    <a asp-controller="Personal"
       asp-action="Crear"
       class="btn btn-primary">
        + Nuevo trabajador
    </a>
</div>

<p>Administración del personal de la empresa de limpieza.</p>

<div class="card shadow-sm">
    <div class="card-body">

        <h5 class="card-title">Trabajadores registrados</h5>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Cargo</th>
                            <th>Fecha de ingreso</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var persona in Model)
                        {
                            <tr>
                                <td>@persona.IdPersonal</td>
                                <td>
                                    @persona.Nombre
                                    @persona.ApellidoPaterno
                                    @persona.ApellidoMaterno
                                </td>
                                <td>@persona.Telefono</td>
                                <td>@persona.Correo</td>
                                <td>@persona.Cargo</td>
                                <td>@persona.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (persona.Estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Editar"
                                       asp-route-id="@persona.IdPersonal"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    @if (persona.Estado)
                                    {
                                        <form asp-action="Eliminar"
                                              asp-route-id="@persona.IdPersonal"
                                              method="post"
                                              style="display:inline"
                                              onsubmit="return confirm('¿Deseas desactivar a este trabajador?');">

                                            <button type="submit" class="btn btn-danger btn-sm">
                                                Desactivar
                                            </button>
                                        </form>
                                    }
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Todavía no hay trabajadores registrados.
            </div>
        }

    </div>
</div>
