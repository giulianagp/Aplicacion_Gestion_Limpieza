@{
    ViewData["Title"] = "Subir evidencia";
}

<div class="container mt-4">

    <h2>Subir evidencia</h2>

    <p class="text-muted">
        Registra una fotografía como evidencia de una actividad de limpieza.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Crear"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">
                        Actividad
                    </label>

                    <select name="idActividad" class="form-select" required>
                        <option value="">Selecciona una actividad</option>

                        @if (ViewBag.Actividades != null)
                        {
                            foreach (var actividad in ViewBag.Actividades)
                            {
                                <option value="@actividad.IdActividad">
                                    @actividad.Titulo
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Descripción
                    </label>

                    <textarea name="descripcion"
                              class="form-control"
                              rows="3"
                              placeholder="Describe el trabajo realizado..."
                              required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Fotografía
                    </label>

                    <input type="file"
                           name="archivo"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           required />

                    <small class="text-muted">
                        Formatos permitidos: JPG, JPEG, PNG y WEBP.
                        Tamaño máximo: 5 MB.
                    </small>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        Guardar evidencia
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>
